<?xml version="1.0" encoding="utf-8"?>
<!--
  The full-offline launcher serves the bundled web app from a local HTTP
  server bound to 127.0.0.1 inside the app (LocalAssetServer). Android 9+
  blocks plain-HTTP loads by default (network security config), which made
  the WebView refuse the app's own start page. This policy re-enables
  cleartext for the loopback address ONLY; every other cleartext host stays
  blocked exactly as the platform default requires.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
